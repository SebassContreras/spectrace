{
  "spectrace-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "node .agents/guard/guard.mjs --agent antigravity --event PreToolUse", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node .agents/guard/guard.mjs --agent antigravity --event PostToolUse", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node .agents/guard/guard.mjs --agent antigravity --event Stop", "timeout": 20 }]
      }
    ]
  }
}
