#!/bin/sh
# spectrace commit-msg: every "Spec: NNN/TNNN" trailer must name a task that is
# ticked [x] in the staged spec, so a task is closed exactly when its commit exists,
# and an [agent] task other than a Review: or a Verify: must bring work: a change
# outside planning/ and the spectrace install. AGENTS.md counts as work when lines
# outside its <!-- spectrace --> block change. On --amend the commit is compared
# with its parent, not with the commit being rewritten.
# A commit without a trailer that changes files beyond planning/ and the spectrace
# install (AGENTS.md, .githooks/, .gitattributes, the CI workflow) is refused;
# "Spec: none" marks a change that belongs to no spec on purpose (a typo, a chore).
# A merge commit is not judged: its changes were judged on their own commits.

msg="$1"
install_re='^(planning/|\.githooks/|AGENTS\.md$|\.gitattributes$|\.github/workflows/spectrace\.yml$|$)'
specs=$(git interpret-trailers --parse < "$msg" | sed -n 's/^Spec: *//p' | tr -d '\r')

git rev-parse -q --verify MERGE_HEAD >/dev/null && exit 0
if [ -z "$specs" ]; then
  if git diff --cached --name-only | grep -qvE "$install_re"; then
    echo "spectrace: no 'Spec: NNN/TNNN' trailer — add the task this commit closes," \
      "or 'Spec: none' in the last paragraph if it belongs to no spec on purpose." >&2
    exit 1
  fi
  exit 0
fi

# An amend keeps the author date of HEAD, and git exports it to hooks as
# GIT_AUTHOR_DATE; a new commit gets the current time.
empty=$(git hash-object -t tree /dev/null)
base=HEAD
if ! git rev-parse -q --verify HEAD >/dev/null; then
  base=$empty
elif [ "${GIT_AUTHOR_DATE%% *}" = "@$(git log -1 --format=%at HEAD)" ]; then
  base=$(git rev-parse -q --verify HEAD^ || echo "$empty")
fi

# Drops the spectrace block; an unclosed block is kept, so nothing after it is lost.
outside_block() {
  tr -d '\r' | awk '
    $0 == "<!-- spectrace -->" { held = $0; next }
    held != "" { held = held "\n" $0; if ($0 == "<!-- /spectrace -->") held = ""; next }
    { print }
    END { if (held != "") print held }'
}
changed=$(git diff --cached --name-only "$base")
work=$(echo "$changed" | grep -cvE "$install_re")
if echo "$changed" | grep -qx 'AGENTS.md' &&
   [ "$(git show "$base:AGENTS.md" 2>/dev/null | outside_block)" != "$(git show :AGENTS.md 2>/dev/null | outside_block)" ]; then
  work=$((work + 1))
fi

fail=0
for ref in $specs; do
  [ "$ref" = none ] && continue
  id=${ref%%/*}
  f=$(git ls-files "planning/specs/$id-*.md" | head -n 1)
  if [ -z "$f" ]; then
    echo "spectrace: $ref — no spec file planning/specs/$id-*.md" >&2; fail=1; continue
  fi
  line=$(git show ":$f" | tr -d '\r' | grep "^- \[[xX]\] $ref ")
  if [ -z "$line" ]; then
    echo "spectrace: $ref is not ticked [x] in $f — tick it in this commit." >&2; fail=1
  elif [ "$work" -eq 0 ] && echo "$line" | grep -q '\[agent\]' \
       && ! echo "$line" | grep -qE '\] (Review|Verify):'; then
    echo "spectrace: $ref is ticked but the commit has no work outside planning/ and the spectrace" \
      "install — add the task's changes, or make it a 'Verify:' task with a 'verified:' note." >&2; fail=1
  fi
done
exit $fail
