#!/bin/sh
# spectrace pre-commit: writes each spec's Status in planning/roadmap.md from its
# [agent] task checkboxes, and refuses a ticked "Review:" task without a
# "reviewed:" note under it, or a ticked "Verify:" task without a "verified:" note. Reads the staged version of every file.

roadmap=planning/roadmap.md
git cat-file -e ":$roadmap" 2>/dev/null || exit 0

specs=$(git ls-files 'planning/specs/[0-9][0-9][0-9]-*.md')
[ -n "$specs" ] || exit 0

statuses=""
for f in $specs; do
  id=$(basename "$f" | cut -c1-3)
  s=$(git show ":$f" | tr -d '\r' | awk -v id="$id" '
    /^- \[[ xX]\] [0-9][0-9][0-9]\/T[0-9]+ \[agent\]/ {
      if ($0 ~ /^- \[ \]/) open++; else closed++
    }
    END {
      if (closed > 0 && open == 0) print "done";
      else if (closed > 0) print "in progress";
      else print "todo"
    }')
  statuses="$statuses$id=$s;"

  bad=$(git show ":$f" | tr -d '\r' | awk '
    function flush() { if (task != "" && !noted) print task; task = "" }
    /^- \[[ xX]\] / {
      flush()
      if ($0 ~ /^- \[[xX]\] [0-9][0-9][0-9]\/T[0-9]+ \[(agent|human)\] Review:/) {
        task = $3; note = "reviewed"; noted = 0
      } else if ($0 ~ /^- \[[xX]\] [0-9][0-9][0-9]\/T[0-9]+ \[(agent|human)\] Verify:/) {
        task = $3; note = "verified"; noted = 0
      }
      next
    }
    note == "reviewed" && /^[ \t]+reviewed( \(self\))?:/ { noted = 1 }
    note == "verified" && /^[ \t]+verified:/ { noted = 1 }
    /^#/ { flush() }
    END { flush() }')
  if [ -n "$bad" ]; then
    echo "spectrace: Review:/Verify: task ticked without its note in $f:" $bad >&2
    echo "  Add an indented line under it: reviewed: <files read> — found <what>," >&2
    echo "  or verified: <commands run, what was checked> — found <what>." >&2
    exit 1
  fi
done

rewrite='
  BEGIN { n = split(st, pairs, ";"); for (i = 1; i <= n; i++) if (pairs[i] != "") {
    split(pairs[i], kv, "="); want[kv[1]] = kv[2] } }
  {
    line = $0; cr = ""
    if (sub(/\r$/, "", line)) cr = "\r"
    if (col == 0 && line ~ /^\|/ && line ~ /\| *Status *\|/) {
      m = split(line, h, "|"); for (i = 1; i <= m; i++) if (h[i] ~ /^ *Status *$/) col = i
    } else if (col > 0 && line ~ /^\| *[0-9][0-9][0-9] *\|/) {
      m = split(line, c, "|"); id = c[2]; gsub(/ /, "", id)
      if (id in want) {
        v = " " want[id]; w = length(c[col])
        while (length(v) < w - 1) v = v " "
        c[col] = v " "; line = c[1]
        for (i = 2; i <= m; i++) line = line "|" c[i]
      }
    }
    printf "%s%s\n", line, cr
  }'

staged=$(git show ":$roadmap" | awk -v st="$statuses" "$rewrite")
if [ "$staged" != "$(git show ":$roadmap")" ]; then
  blob=$(printf '%s\n' "$staged" | git hash-object -w --stdin)
  git update-index --cacheinfo 100644,"$blob","$roadmap"
  tmp="$roadmap.spectrace-tmp"
  awk -v st="$statuses" "$rewrite" "$roadmap" > "$tmp" && mv "$tmp" "$roadmap"
fi
exit 0
