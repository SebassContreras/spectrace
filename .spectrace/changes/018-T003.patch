@@ -0,0 +1,124 @@
+"""Behavior-driven tests for spectrace audit module (spec 018)."""
+import contextlib, io, json, os, shutil, subprocess, tempfile, unittest
+import importlib.util
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ASSETS = os.environ.get("SPECTRACE_ASSETS") or os.path.join(HERE, "..", "skills", "spectrace-start", "assets")
+spec = importlib.util.spec_from_file_location("spectrace_trace", os.path.join(ASSETS, "trace.py"))
+trace = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(trace)
+
+GIT_ENV = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t",
+               GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
+
+
+def run(cwd, *args, **kwargs):
+    env = kwargs.get("env", GIT_ENV)
+    return subprocess.run(["git", "-C", cwd, *args], check=True, capture_output=True, text=True, env=env)
+
+
+class TestAudit(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.mkdtemp()
+        run(self.dir, "init", "-q")
+        run(self.dir, "config", "user.name", "t")
+        run(self.dir, "config", "user.email", "t@t")
+
+        os.makedirs(os.path.join(self.dir, "planning", "specs", "001-auth"), exist_ok=True)
+        os.makedirs(os.path.join(self.dir, ".spectrace"), exist_ok=True)
+
+        with open(os.path.join(self.dir, "planning", "roadmap.md"), "w", encoding="utf-8") as f:
+            f.write("# Roadmap\n\n| ID | Spec | Status | Depends on | Stage | Priority |\n"
+                    "|---|---|---|---|---|---|\n"
+                    "| 001 | auth | todo | — | design | 1 |\n")
+
+        with open(os.path.join(self.dir, "planning", "architecture.md"), "w", encoding="utf-8") as f:
+            f.write("# Architecture\n\n- A1@1: Standard library only.\n- A2@1: Single responsibility.\n")
+
+        with open(os.path.join(self.dir, "AGENTS.md"), "w", encoding="utf-8") as f:
+            f.write("# Agents\n\nFollow (A1) for dependencies.\n")
+
+        with open(os.path.join(self.dir, "planning", "product.md"), "w", encoding="utf-8") as f:
+            f.write("# Product\n\n## Not for now\n\n- Cloud orchestration: no external servers.\n")
+
+        with open(os.path.join(self.dir, "planning", "specs", "001-auth", "requirements.md"), "w", encoding="utf-8") as f:
+            f.write("# 001 — auth — Requirements\n\n- R1@1: User authentication.\n\n## Out of scope\n\n- Cloud orchestration.\n")
+
+        with open(os.path.join(self.dir, "planning", "specs", "001-auth", "design.md"), "w", encoding="utf-8") as f:
+            f.write("# 001 — auth — Design\n\n- D1@1 (implements R1): Local login.\n")
+
+        with open(os.path.join(self.dir, "planning", "specs", "001-auth", "tasks.md"), "w", encoding="utf-8") as f:
+            f.write("# 001 — auth — Tasks\n\n- [ ] T001 [agent] [status:todo] Local login\n      covers: D1@1\n")
+
+        with open(os.path.join(self.dir, ".spectrace", "interview.md"), "w", encoding="utf-8") as f:
+            f.write("# Interview\n\n| dimension | status | answer |\n|---|---|---|\n| runtime | covered | python |\n")
+
+        run(self.dir, "add", "-A")
+        run(self.dir, "commit", "-q", "-m", "init", env=GIT_ENV)
+        with contextlib.redirect_stdout(io.StringIO()):
+            trace.main(["-C", self.dir, "status", "--write"])
+
+    def tearDown(self):
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+    def test_architecture_alignment_detects_unreferenced_a_item(self):
+        # Arrange: A1 is in AGENTS.md, but A2 is missing
+        # Act
+        stdout = io.StringIO()
+        with contextlib.redirect_stdout(stdout):
+            code = trace.main(["-C", self.dir, "audit", "--json"])
+        self.assertEqual(code, 0)
+
+        # Assert: A2 is reported as warning, A1 is not
+        data = json.loads(stdout.getvalue())
+        messages = [item["message"] for item in data["audit"]]
+        self.assertTrue(any("A2 has no operative entry" in m for m in messages))
+        self.assertFalse(any("A1 has no operative entry" in m for m in messages))
+
+    def test_scope_alignment_flags_out_of_scope_concepts(self):
+        # Arrange: Add task mentioning 'cloud orchestration'
+        tasks_path = os.path.join(self.dir, "planning", "specs", "001-auth", "tasks.md")
+        with open(tasks_path, "a", encoding="utf-8") as f:
+            f.write("- [ ] T002 [agent] [status:todo] Implement cloud orchestration worker\n      covers: D1@1\n")
+
+        # Act & Assert
+        stdout = io.StringIO()
+        with contextlib.redirect_stdout(stdout):
+            trace.main(["-C", self.dir, "audit", "--json"])
+        data = json.loads(stdout.getvalue())
+        messages = [item["message"] for item in data["audit"]]
+        self.assertTrue(any("cloud orchestration" in m for m in messages))
+
+    def test_interview_alignment_flags_open_dimensions(self):
+        # Arrange: Add an open dimension in interview.md matching spec 001
+        interview_path = os.path.join(self.dir, ".spectrace", "interview.md")
+        with open(interview_path, "a", encoding="utf-8") as f:
+            f.write("| 001.requirements | open | |\n")
+
+        # Act & Assert
+        stdout = io.StringIO()
+        with contextlib.redirect_stdout(stdout):
+            trace.main(["-C", self.dir, "audit", "--json"])
+        data = json.loads(stdout.getvalue())
+        messages = [item["message"] for item in data["audit"]]
+        self.assertTrue(any("001.requirements" in m for m in messages))
+
+    def test_check_command_with_audit_flag(self):
+        # Arrange & Act
+        stdout = io.StringIO()
+        with contextlib.redirect_stdout(stdout):
+            code = trace.main(["-C", self.dir, "check", "--audit"])
+        out = stdout.getvalue()
+        # Assert: check output includes audit findings (A2 warning) and exits 0 (warnings only)
+        self.assertEqual(code, 0)
+        self.assertIn("A2 has no operative entry", out)
+
+    def test_audit_strict_mode_exits_nonzero_on_warnings(self):
+        # Act: running audit with --strict when warnings exist returns exit code 1
+        with contextlib.redirect_stdout(io.StringIO()):
+            code = trace.main(["-C", self.dir, "audit", "--strict"])
+        self.assertEqual(code, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
