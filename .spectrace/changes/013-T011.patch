+"""Tests for the code index (index.py, facts.py, linker.py) on a fixture project.
+
+Run: python -m unittest discover -s tests
+"""
+import contextlib
+import io
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.environ.get("SPECTRACE_ASSETS") or os.path.join(HERE, "..", "skills", "spectrace-start", "assets"))
+from spectrace import index  # noqa: E402
+from spectrace.cli import main  # noqa: E402
+from spectrace.linker import Graph  # noqa: E402
+
+GIT_ENV = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
+FILES = {
+    "planning/roadmap.md": "| ID | Spec | Status | Depends on | Stage | Priority |\n|---|---|---|---|---|---|\n"
+                           "| 001 | app | | — | | 1 |\n",
+    "planning/specs/001-app/requirements.md": "- R1@1: The app stores data.\n",
+    "planning/specs/001-app/design.md": "- D1@1 (implements R1): A Store class.\n",
+    "planning/specs/001-app/tasks.md": "- [ ] T001 [agent] [status:todo] Drop the legacy export\n      covers: D1@1\n",
+    "app/__init__.py": "",
+    "app/store.py": "class Store:\n    def save(self):\n        self._write()\n\n    def _write(self):\n        pass\n\n\n"
+                    "def legacy_export():\n    pass\n",
+    "app/cli.py": "from app.store import Store\n\n\ndef main(helper):\n    Store().save()\n    helper._write()\n",
+    "tests/test_store.py": "from app.store import Store\n\n\ndef test_save():\n    Store().save()\n",
+    "broken.py": "def broken(:\n",
+    "README.md": "# App\n\nCall `legacy_export` to export.\n",
+}
+
+
+class IndexTest(unittest.TestCase):
+    def setUp(self):
+        self.root = tempfile.mkdtemp(prefix="spectrace-index-")
+        self.addCleanup(shutil.rmtree, self.root, True)
+        for rel, text in FILES.items():
+            self.write(rel, text)
+        subprocess.run(["git", "init", "-q"], cwd=self.root, check=True, env=GIT_ENV)
+        subprocess.run(["git", "add", "-A"], cwd=self.root, check=True, env=GIT_ENV)
+        subprocess.run(["git", "commit", "-qm", "init"], cwd=self.root, check=True, env=GIT_ENV)
+        self.run_trace("status", "--write")
+
+    def write(self, rel, text):
+        path = os.path.join(self.root, *rel.split("/"))
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8", newline="\n") as f:
+            f.write(text)
+
+    def run_trace(self, *args):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
+            code = main(["-C", self.root, *args])
+        return code, out.getvalue()
+
+    def graph(self):
+        db = index.refresh(self.root)
+        self.addCleanup(db.close)
+        return Graph(db)
+
+    def edge(self, src, dst):
+        return next(e for e in self.graph().edges
+                    if (e.src_path + "::" + str(e.src_symbol), e.dst_path + "::" + str(e.dst_symbol)) == (src, dst))
+
+    def test_a_refresh_re_reads_only_the_file_that_changed(self):
+        index.refresh(self.root).close()
+        self.write("app/cli.py", FILES["app/cli.py"] + "\n\ndef extra():\n    pass\n")
+        with mock.patch.object(index, "extract", wraps=index.extract) as extract:
+            index.refresh(self.root).close()
+        self.assertEqual([c.args[0] for c in extract.call_args_list], ["app/cli.py"])
+
+    def test_a_name_bound_by_an_import_resolves_exactly(self):
+        edge = self.edge("app/cli.py::main", "app/store.py::Store")
+        self.assertEqual(edge.confidence, "exact")
+
+    def test_self_method_resolves_exactly_through_the_class(self):
+        edge = self.edge("app/store.py::Store.save", "app/store.py::Store._write")
+        self.assertEqual(edge.confidence, "exact")
+
+    def test_an_attribute_of_an_unknown_object_is_inferred_with_its_candidates(self):
+        edge = self.edge("app/cli.py::main", "app/store.py::Store._write")
+        self.assertEqual((edge.confidence, edge.candidates), ("inferred", 1))
+
+    def test_impact_lists_dependents_and_the_tests_that_reference_the_code(self):
+        out = self.run_trace("impact", "app/store.py::Store")[1]
+        self.assertIn("- app/cli.py::main [uses, depth 1] line 5", out)
+        self.assertIn("Tests that reference it: tests/test_store.py::test_save (exact)", out)
+
+    def test_impact_out_lists_what_the_code_depends_on(self):
+        out = self.run_trace("impact", "app/cli.py::main", "--direction", "out")[1]
+        self.assertIn("- app/store.py::Store [uses, depth 1] line 5", out)
+
+    def test_impact_never_claims_no_impact(self):
+        out = self.run_trace("impact", "app/store.py::legacy_export")[1]
+        self.assertIn("No dependents found among the analysed files.", out)
+        self.assertIn("1 file(s) (does not parse: SyntaxError)", out)
+
+    def test_files_that_do_not_parse_are_reported(self):
+        out = self.run_trace("index", "--status")[1]
+        self.assertIn("not analysed (does not parse: SyntaxError): 1 — broken.py", out)
+
+    def test_a_mention_of_a_removed_symbol_warns_and_never_holds_the_spec_open(self):
+        self.run_trace("start", "001/T001")
+        self.write("app/store.py", FILES["app/store.py"].split("\n\ndef legacy_export")[0] + "\n")
+        self.run_trace("done", "001/T001")
+        code, out = self.run_trace("check", "--strict")
+        self.assertIn("README.md:3  mentions legacy_export, which 001/T001 removed from app/store.py", out)
+        self.assertEqual(code, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
