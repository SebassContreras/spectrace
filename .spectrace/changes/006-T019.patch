+    def test_a_retiring_task_holds_the_strict_gate_until_done(self):
+        self.task("001/T002", {"src/expiry.txt": "checkExpiry(session)\n"})  # covers D2, which won't change
+        self.write("planning/specs/001-auth/tasks.md", self.read("planning/specs/001-auth/tasks.md") +
+                   "- [ ] T004 [agent] [status:todo] Rewrite the expiry check\n"
+                   "      covers: D2@1\n      retires: T002\n")
+        run(self.root, "status", "--write")
+        code, out = self.check("--strict")
+        self.assertEqual(code, 1)
+        self.assertIn("cleanup of 001/T002 not done yet", out)
+        self.task("001/T004", {"src/expiry.txt": "checkExpiry(session, now)\n"})
+        self.assertNotIn("cleanup of", self.check("--strict")[1])
