+
+def numstat(root, a, b):
+    out, parts = [], diff(root, a, b, "--numstat", "-z").split("\0")
+    while parts:
+        head = parts.pop(0)
+        if not head.strip():
+            continue
+        add, rem, path = head.lstrip().split("\t", 2)
+        if not path:  # rename: old and new paths follow
