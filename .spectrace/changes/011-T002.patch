+    except TraceError:
+        return None
+
+
+def drop(root, name):
+    if kept(root, name):
+        git(root, "update-ref", "-d", f"refs/spectrace/{name}")
+
+
+def reference_tree(root):
+    """The tree when the last task closed; else HEAD; else empty."""
+    if last := kept(root, "last"):
+        return last
+    try:
+        return git(root, "rev-parse", "--verify", "--quiet", "HEAD^{tree}")
+    except TraceError:
+        return EMPTY_TREE
