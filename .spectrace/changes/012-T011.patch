index 0000000..56ecd6a
--- /dev/null
+++ b/skills/spectrace-start/assets/spectrace/views/__init__.py
@@ -0,0 +1,17 @@
+"""Read-only views over the records: one module per command."""
+from .. import TraceError
+
+
+def address(raw):
+    """(path, symbol or None) from `path` or `path::Qualified.name`."""
+    path, _, symbol = raw.partition("::")
+    path = path.replace("\\", "/").strip()
+    path = path[2:] if path.startswith("./") else path
+    if not path:
+        raise TraceError("use a code address: path or path::Qualified.name")
+    return path, symbol.strip() or None
+
+
+def matches(name, symbol):
+    """A symbol answers for itself and for what it contains (`Store` for `Store.save`)."""
+    return name == symbol or name.startswith(symbol + ".") or name.startswith(symbol + " > ")
diff --git a/skills/spectrace-start/assets/spectrace/views/why.py b/skills/spectrace-start/assets/spectrace/views/why.py
new file mode 100644
index 0000000..18fa28a
--- /dev/null
+++ b/skills/spectrace-start/assets/spectrace/views/why.py
@@ -0,0 +1,40 @@
+"""`trace why <path[::symbol]>`: from code to the tasks and decisions behind it."""
+from .. import records
+from . import address, matches
+
+
+def exact_hits(recs, path, symbol):
+    """[(task ref, what it did)] from the records, newest task first, following renames back."""
+    hits = []
+    for ref in sorted(recs, reverse=True):
+        f = recs[ref]["files"].get(path)
+        if f is None:
+            continue
+        if symbol is None:
+            hits.append((ref, f["status"]))
+        else:
+            found = [s for s in f["symbols"] if matches(s["name"], symbol)]
+            hits += [(ref, s["name"] + " " + s["change"] + (f" from {s['from']}" if s.get("from") else ""))
+                     for s in found]
+            symbol = next((s["from"] for s in found if s["name"] == symbol and s.get("from")), symbol)
+        path = f.get("from", path)
+    return hits
+
+
+def cmd_why(repo, args):
+    path, symbol = address(args.address)
+    hits = exact_hits(records.load(repo.root), path, symbol)
+    print(f"# Why {args.address}\n")
+    if not hits:
+        print(f"outside the trace: no task recorded {args.address}")
+        return 0
+    for ref, what in hits:
+        task = repo.find_task(ref)
+        if task is None:
+            print(f"- {ref} [unknown task] {what}")
+            continue
+        print(f"- {task.ref} [{task.status}] {task.text}\n    {what}")
+        print(f"    covers: {', '.join(repo.covers_label(task))}")
+        if retired := repo.retired_by(task):
+            print(f"    retired by: {', '.join(retired)}")
+    return 0
