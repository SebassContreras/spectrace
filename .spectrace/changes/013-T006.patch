+            extra = f", {e.candidates} candidates" if e.confidence == "inferred" else ""
+            print(f"- {p}{'::' + s if s else ''} [{e.kind}, depth {lv}{extra}] line {e.line}")
+        if len(group) > LIST_LIMIT:
