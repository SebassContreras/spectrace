+"""Tests for `trace packet`: deterministic, works on a clean clone, reports severity signals.
+
+Run: python -m unittest discover -s tests
+"""
+import contextlib
+import io
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.environ.get("SPECTRACE_ASSETS") or os.path.join(HERE, "..", "skills", "spectrace-start", "assets"))
+from spectrace.cli import main  # noqa: E402
+
+GIT_ENV = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
+STORE = "def load(path):\n    return open(path).read()\n\n\ndef save(path, data):\n    open(path, 'w').write(data)\n"
+FILES = {
+    "planning/roadmap.md": "| ID | Spec | Status | Depends on | Stage | Priority |\n|---|---|---|---|---|---|\n"
+                           "| 001 | store | | — | | 1 |\n",
+    "planning/specs/001-store/requirements.md": "- R1@1: Data is stored.\n",
+    "planning/specs/001-store/design.md": "- D1@1 (implements R1): Data is a text file.\n",
+    "planning/specs/001-store/tasks.md": "- [ ] T001 [agent] [status:todo] Store\n      covers: D1@1\n"
+                                         "- [ ] T002 [agent] [status:todo] Change the store\n      covers: D1@1\n",
+    "cli.py": "from store import load\n\n\ndef show(path):\n    print(load(path))\n",
+}
+
+
+def git(root, *args):
+    return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, check=True, env=GIT_ENV).stdout.strip()
+
+
+class PacketTest(unittest.TestCase):
+    def setUp(self):
+        self.root = tempfile.mkdtemp(prefix="spectrace-packet-")
+        self.addCleanup(shutil.rmtree, self.root, True)
+        for rel, text in FILES.items():
+            self.write(rel, text)
+        git(self.root, "init", "-q")
+        git(self.root, "add", "-A")
+        git(self.root, "commit", "-qm", "init")
+        self.run_trace(self.root, "status", "--write")
+        self.task("001/T001", STORE)
+        git(self.root, "add", "-A")
+        git(self.root, "commit", "-qm", "store")
+        self.base = git(self.root, "rev-parse", "HEAD")
+
+    def write(self, rel, text, root=None):
+        path = os.path.join(root or self.root, *rel.split("/"))
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8", newline="\n") as f:
+            f.write(text)
+
+    def run_trace(self, root, *args):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
+            code = main(["-C", root, *args])
+        return code, out.getvalue()
+
+    def task(self, ref, store):
+        self.run_trace(self.root, "start", ref)
+        self.write("store.py", store)
+        self.run_trace(self.root, "done", ref)
+
+    def change_the_store(self):
+        """T002: save gains a parameter and load is removed while cli.py still calls it."""
+        self.task("001/T002", "def save(path, data, mode='w'):\n    open(path, mode).write(data)\n")
+        git(self.root, "add", "-A")
+        git(self.root, "commit", "-qm", "change the store")
+
+    def test_the_same_input_gives_the_same_packet(self):
+        first = self.run_trace(self.root, "packet", "001/T001")
+        second = self.run_trace(self.root, "packet", "001/T001")
+        self.assertEqual(first, second)
+        self.assertEqual(first[0], 0)
+
+    def test_a_diff_packet_works_on_a_clean_clone_without_state_or_index(self):
+        self.change_the_store()
+        clone = tempfile.mkdtemp(prefix="spectrace-clone-")
+        self.addCleanup(shutil.rmtree, clone, True)
+        git(clone, "clone", "-q", self.root, ".")
+        code, out = self.run_trace(clone, "packet", "--diff", "--base", self.base)
+        self.assertEqual(code, 0)
+        self.assertIn("# Review packet: 001/T002", out)
+        self.assertIn("- 001/D1@1", out)
+        self.assertFalse(os.path.exists(os.path.join(clone, ".spectrace", "index.db")), "the index stays in memory")
+        self.assertFalse(os.path.exists(os.path.join(clone, ".spectrace", "state.json")))
+
+    def test_the_packet_reports_severity_signals(self):
+        self.change_the_store()
+        out = self.run_trace(self.root, "packet", "001/T002")[1]
+        self.assertIn("- signature changed: store.py::save (path, data) → (path, data, mode='w')", out)
+        self.assertIn("- removed but still referenced: store.py::load — 1 reference(s) by that name (inferred)", out)
+        self.assertIn("- no test references: store.py::save", out)
+
+
+if __name__ == "__main__":
+    unittest.main()
